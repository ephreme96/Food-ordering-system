# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/food_ordering

# ─── JWT / AUTH ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_USE_SECRETS_TOKEN_HEX_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── RECEIPT SIGNING ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RECEIPT_HMAC_SECRET=CHANGE_ME_USE_SECRETS_TOKEN_HEX_32
RECEIPT_EXPIRY_SECONDS=604800

# ─── PAYMENT SANDBOX ─────────────────────────────────────────────────────────
# Set to "false" when you have real merchant credentials
PAYMENT_SANDBOX=true

# ─── CHAPA PAYMENT GATEWAY ───────────────────────────────────────────────────
# Get your keys from: https://dashboard.chapa.co
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_BASE_URL=https://api.chapa.co/v1

# ─── TELEBIRR (Ethio Telecom) ─────────────────────────────────────────────────
# Register at: https://developer.ethiotelecom.et
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=your_merchant_short_code
TELEBIRR_NOTIFY_URL=https://yourdomain.com/api/payments/callback/telebirr
TELEBIRR_API_BASE_URL=https://196.188.120.3:38443/apiaccess/payment/gateway

# ─── CBE BIRR (Commercial Bank of Ethiopia) ──────────────────────────────────
# Register at your CBE merchant portal
CBE_BIRR_MERCHANT_ID=your_cbe_merchant_id
CBE_BIRR_API_KEY=your_cbe_api_key
CBE_BIRR_NOTIFY_URL=https://yourdomain.com/api/payments/callback/cbebirr
CBE_BIRR_API_BASE_URL=https://api.cbebirr.et/v1

# ─── BANK TRANSFER ────────────────────────────────────────────────────────────
# Displayed to customers who choose manual bank transfer
BANK_NAME=Commercial Bank of Ethiopia
BANK_ACCOUNT_NUMBER=1000123456789
BANK_ACCOUNT_NAME=Restaurant Name

# ─── SMS (Africa's Talking) ──────────────────────────────────────────────────
# Register at: https://africastalking.com
# Use username="sandbox" and leave API_KEY empty to log-only in dev
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=

# ─── APP URLS ─────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── DEFAULT ACCOUNTS (change immediately after first run) ───────────────────
ADMIN_DEFAULT_PASSWORD=Admin@1234
KITCHEN_DEFAULT_PASSWORD=Kitchen@1234
CASHIER_DEFAULT_PASSWORD=Cashier@1234

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────
PORT=8000
RESTAURANT_NAME=Taste of Ethiopia
ENVIRONMENT=development
HTTPS_ENABLED=false
